  "termsJa": {
    "codonJa": "コドンは、mRNAの塩基配列(A・U・G・C)を5'側から3つずつ区切った3つ組。4種の塩基が3つ並ぶので、4×4×4=64通りある。",
    "mappingJa": "64通りのコドンのうち61通りが20種のアミノ酸のどれかを、残りの3通り(UAA・UAG・UGA)が「ここで止まる」という終止の合図を指定する。",
    "startJa": "AUGはメチオニン(Met)を指定すると同時に、翻訳を始める位置の目印(開始コドン)にもなる。",
    "stopJa": "UAA・UAG・UGAはどのアミノ酸も指定しない終止コドン。ここで翻訳が止まる。",
    "degeneracyJa": "1種のアミノ酸に複数のコドンが対応することを、コドンの縮重という。",
    "wobbleJa": "縮重は主に3文字目(コドンの3'側の塩基)に集中している。コドンの3文字目は、tRNAのアンチコドンの1文字目と対合するとき、ふつうの塩基対の規則よりゆるい組み合わせでも対になれる。この現象をゆらぎ(wobble)という。",
    "wobbleScopeJa": "どの塩基どうしがゆらぎで対になれるか(イノシンなど)の詳細は、この教材では扱わない。"
  },
  "strands": {
    "senseJa": "mRNAは、DNAのセンス鎖(非鋳型鎖)と同じ配列で、TがUに置き換わっただけのもの。",
    "templateJa": "鋳型鎖はmRNAと相補的で、向きは逆(逆平行)。鋳型鎖を3'→5'の向きに読み、1文字ずつ相補的な塩基(A→U、T→A、G→C、C→G)に置き換えると、mRNAが5'→3'の向きに得られる。",
    "complementSourceJa": "相補の対応は、DNAの二重らせん(dna-double-helix)の相補鎖生成と同じ表(data/dna-double-helix.jsonのcomplement)を使う。違いは、mRNA側ではAの相手がTではなくUになることだけ。",
    "tableToggleJa": "鋳型鎖の表示では、各コドンに対応する鋳型鎖の3文字を3'→5'の向きで示す。表の行・列の並びはmRNAのときと同じにしてある。"
  },
  "translate": {
    "maxLength": 30,
    "presets": [
      "AUGGCUUUUUAA",
      "GCAUGAAACGCUGGUAGCA",
      "AUGUCUAGCCGUAGGUUAUGA",
      "AUGGGAGGCGGG"
    ],
    "stepsJa": [
      "mRNAを用意する",
      "開始コドンAUGを探す",
      "3文字ずつ区切って表を引く"
    ],
    "frameJa": "5'側から見て最初に現れるAUGが開始コドンになり、そこから3文字ずつの区切り方(読み枠)が決まる。AUGより前の塩基は翻訳されない。",
    "stopJa": "終止コドンが現れたところで翻訳が止まる。終止コドンはアミノ酸を指定しない。",
    "noStartJa": "開始コドンAUGが見つからないため、翻訳は始まらない。",
    "noStopJa": "終止コドンが現れないまま配列が終わった。ここに示したのは入力した範囲だけの結果である。",
    "leftoverJa": "最後の3文字に満たない塩基はコドンにならない。"
  },
